# OpenSSL configuration for the TLS 1.2-only coturn (turnserver-tls12.conf): libssl applies
# system_default to every SSL context it creates, so the server offers TLS 1.2 at most.
openssl_conf = openssl_init

[openssl_init]
ssl_conf = ssl_section

[ssl_section]
system_default = system_default_section

[system_default_section]
MaxProtocol = TLSv1.2
